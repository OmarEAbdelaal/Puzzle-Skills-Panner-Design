<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Panner" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_ink</item>
        <item name="colorPrimaryDark">@color/felt_panel</item>
        <item name="colorAccent">@color/brand_pink</item>
        <item name="android:windowBackground">@color/felt_bg</item>
        <item name="android:statusBarColor">@color/felt_panel</item>
        <item name="android:navigationBarColor">@color/felt_panel</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Shown for the instant between launch and the WebView painting -->
    <style name="Theme.Panner.Splash" parent="Theme.Panner">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>

</resources>
